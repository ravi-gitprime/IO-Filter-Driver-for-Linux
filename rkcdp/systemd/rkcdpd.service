[Unit]
Description=rkcdp - ship disk writes to the replica journal
After=network-online.target remote-fs.target
Wants=network-online.target remote-fs.target

[Service]
Type=simple
ExecStart=/opt/rkcdp/rkcdpd
Nice=10
IOSchedulingClass=idle
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
