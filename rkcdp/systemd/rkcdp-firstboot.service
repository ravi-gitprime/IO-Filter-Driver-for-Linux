[Unit]
Description=rkcdp first boot after rebuild - heal as standby
After=network-online.target postgresql.service
Before=kvmdr-api.service kvmdr-dbwatchdog.service kvmdr-db-fence.service
ConditionPathExists=/etc/kvmdr/rkcdp-rebuilt-standby

[Service]
Type=oneshot
ExecStart=/opt/rkcdp/rkcdp-firstboot.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
