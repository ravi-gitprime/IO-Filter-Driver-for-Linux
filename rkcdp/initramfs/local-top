#!/bin/sh
# initramfs-tools local-top: put dm-cdp under the whole root disk before
# root is mounted, and point ROOT at the wrapped partition.
# Disable with kernel arg  kvmdr.cdp=0
PREREQ="udev"
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac
. /scripts/functions

DM_NAME=rkcdp
[ -f /etc/rkcdp/initramfs.conf ] && . /etc/rkcdp/initramfs.conf

for x in $(cat /proc/cmdline); do
	case "$x" in kvmdr.cdp=0) log_warning_msg "rkcdp: disabled by kernel arg"; exit 0;; esac
done

# resolve the root partition from ROOT= (UUID=, LABEL=, or /dev path)
case "$ROOT" in
	UUID=*|LABEL=*|PARTUUID=*) PART=$(blkid -l -t "$ROOT" -o device 2>/dev/null) ;;
	*) PART="$ROOT" ;;
esac
# blkid may need udev to have settled
n=0
while [ -z "$PART" ] && [ $n -lt 30 ]; do
	sleep 0.5; n=$((n+1))
	case "$ROOT" in UUID=*|LABEL=*|PARTUUID=*) PART=$(blkid -l -t "$ROOT" -o device 2>/dev/null);; esac
done
[ -n "$PART" ] || { log_warning_msg "rkcdp: cannot resolve $ROOT, booting unwrapped"; exit 0; }
case "$PART" in /dev/mapper/*|/dev/dm-*) exit 0;; esac   # already wrapped

PNAME=$(basename "$PART")
DISK=$(basename "$(readlink -f "/sys/class/block/$PNAME/..")")
PNUM=$(cat "/sys/class/block/$PNAME/partition" 2>/dev/null)
[ -n "$DISK" ] && [ -n "$PNUM" ] && [ -b "/dev/$DISK" ] || { log_warning_msg "rkcdp: no parent disk for $PART"; exit 0; }

modprobe dm-mod
modprobe dm-cdp || { log_warning_msg "rkcdp: dm-cdp module missing, booting unwrapped"; exit 0; }
SECT=$(blockdev --getsz "/dev/$DISK")
if ! dmsetup create "$DM_NAME" --table "0 $SECT cdp /dev/$DISK 0"; then
	log_warning_msg "rkcdp: dmsetup create failed, booting unwrapped"; exit 0
fi
kpartx -a -s "/dev/mapper/$DM_NAME"
NEWROOT="/dev/mapper/${DM_NAME}${PNUM}"
n=0
while [ ! -b "$NEWROOT" ] && [ $n -lt 20 ]; do sleep 0.25; n=$((n+1)); done
if [ -b "$NEWROOT" ]; then
	echo "ROOT=$NEWROOT" >> /conf/param.conf
	log_success_msg "rkcdp: root disk /dev/$DISK wrapped, root=$NEWROOT"
else
	log_warning_msg "rkcdp: $NEWROOT did not appear; removing wrap"
	kpartx -d "/dev/mapper/$DM_NAME"; dmsetup remove "$DM_NAME"
fi
exit 0
