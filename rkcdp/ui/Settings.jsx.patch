+                      <div style={{ display: 'grid', gridTemplateColumns: '2fr 1fr 1fr 1fr', gap: 10 }}>
+                        <Field label="Proxmox host">
+                          <Sel value={form.host_id} onChange={v => setForm(f => ({ ...f, host_id: v }))}
+                               options={hosts.map(h => ({ value: h.host_id, label: `${h.hostname} (${h.ip})` }))} />
+                        </Field>
+                        <Field label="VMID" hint="blank = next free 9100+">
+                          <Inp value={form.vmid} onChange={v => setForm(f => ({ ...f, vmid: v }))} placeholder="auto" />
+                        </Field>
+                        <Field label="Storage"><Inp value={form.storage} onChange={v => setForm(f => ({ ...f, storage: v }))} /></Field>
+                        <Field label="Bridge"><Inp value={form.bridge} onChange={v => setForm(f => ({ ...f, bridge: v }))} /></Field>
+                      </div>
+                      {form.force && <div style={{ fontSize: 11, color: 'var(--yellow, #eab308)', marginBottom: 8 }}>
+                        This node still reports alive. Rebuilding creates a second VM with the same MAC/IP — stop the old one first.
+                      </div>}
+                      <div style={{ display: 'flex', gap: 8 }}>
+                        <button style={btnStyle('red')} disabled={busy} onClick={submit}>{busy ? 'Starting…' : 'Rebuild as STANDBY'}</button>
+                        <button style={btnStyle()} onClick={() => setForm(null)}>Cancel</button>
+                      </div>
+                    </td></tr>
+                  )}
+                </Fragment>
+              )
+            })}
+          </tbody>
+        </table>}
+      </Section>
+    </>
+  )
+}
+
+function RebuildProgress({ p }) {
+  const names = ['check', 'quiesce', 'copy', 'mark standby', 'create VM', 'boot']
+  return (
+    <div>
+      <div style={{ display: 'flex', gap: 6, marginBottom: 6, flexWrap: 'wrap' }}>
+        {names.map((nm, i) => {
+          const n = i + 1
+          const done = p.step > n || p.state === 'done'
+          const cur = p.step === n && p.state === 'running'
+          const bad = p.step === n && p.state === 'failed'
+          return <span key={nm} style={{
+            fontSize: 10, padding: '2px 8px', borderRadius: 10,
+            background: bad ? 'rgba(239,68,68,0.15)' : done ? 'rgba(34,197,94,0.15)' : cur ? 'rgba(59,130,246,0.15)' : 'var(--bg3)',
+            color: bad ? 'var(--red)' : done ? 'var(--green)' : cur ? 'var(--blue)' : 'var(--text3)',
+          }}>{n}. {nm}</span>
+        })}
+      </div>
+      <div style={{ fontSize: 12, color: p.state === 'failed' ? 'var(--red)' : p.state === 'done' ? 'var(--green)' : 'var(--text)' }}>
+        {p.state === 'failed' ? `Failed: ${p.error}` : p.msg}
+      </div>
+    </div>
+  )
+}
