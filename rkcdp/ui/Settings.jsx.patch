+  const load = async () => {
+    try {
+      const [n, h] = await Promise.all([axios.get('/api/rkcdp/nodes'), axios.get('/api/hosts')])
+      // A missing endpoint falls through to the UI catch-all and returns HTML,
+      // not JSON — guard so the page degrades to a message instead of crashing.
+      setApiMissing(!Array.isArray(n.data))
+      setNodes(Array.isArray(n.data) ? n.data : [])
+      setHosts(Array.isArray(h.data) ? h.data.filter(x => !x.hv_type || /prox|pve/i.test(x.hv_type)) : [])
+    } catch (e) {
+      showToast?.(`Could not load recovery state: ${e.message}`, 'error')
+    } finally {
+      setLoading(false)
+    }
+  }
+  useEffect(() => {
+    load()
+    const t = setInterval(load, 3000)
+    return () => clearInterval(t)
+  }, [])
+
+  const stateBadge = (s) => {
