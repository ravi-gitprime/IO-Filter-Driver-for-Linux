+// ─── Manager Recovery (rkcdp) ───────────────────────────────────────────────
+// Settings → Manager Recovery. Shows every node protected by rkcdpd (from
+// /replication/_kvmdr/rkcdp/<node>/) and rebuilds a dead one from its
+// replica.raw on a Proxmox host. Rebuilt nodes always come up STANDBY.
+
+function ManagerRecoveryTab({ showToast }) {
+  const [nodes, setNodes]   = useState([])
+  const [hosts, setHosts]   = useState([])
+  const [loading, setLoading] = useState(true)
+  const [form, setForm]     = useState(null)   // { node, host_id, vmid, storage, bridge, force }
+  const [busy, setBusy]     = useState(false)
+  const [apiMissing, setApiMissing] = useState(false)
