+                    </td>
+                    <td style={td}>{lag == null ? '—' : lag === 0 ? <span style={{ color: 'var(--green)' }}>0</span> : `${lag} writes`}</td>
+                    <td style={td}>{gb(n.replica_used_bytes)}<div style={{ fontSize: 10, color: 'var(--text3)' }}>of {gb(n.replica_bytes)}</div></td>
+                    <td style={{ ...td, textAlign: 'right' }}>
+                      {n.rebuilding
