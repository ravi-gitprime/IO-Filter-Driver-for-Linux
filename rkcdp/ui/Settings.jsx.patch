+      syncing:     { label: 'Syncing',     color: 'var(--blue)' },
+      bitmap:      { label: 'Bitmap',      color: 'var(--yellow, #eab308)' },
+      stale:       { label: 'Stale',       color: 'var(--red)' },
+      unprotected: { label: 'Unprotected', color: 'var(--text3)' },
+    }[s] || { label: s, color: 'var(--text3)' }
+    return <span style={{ color: m.color, fontWeight: 600 }}>{m.label}</span>
+  }
+  const gb = (b) => b == null ? '—' : `${(b / 1073741824).toFixed(1)} GB`
+  const ago = (t) => t ? `${Math.max(0, Math.round(Date.now() / 1000 - t))}s ago` : '—'
+  const when = (t) => t ? new Date(t * 1000).toLocaleTimeString() : '—'
+
+  const openRebuild = (n) => setForm({
