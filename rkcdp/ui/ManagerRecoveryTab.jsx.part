// ─── Manager Recovery (rkcdp) ───────────────────────────────────────────────
// Settings → Manager Recovery. One row per manager: status, replica age or
// first-sync progress, replica size, Rebuild. Rebuilt nodes come up STANDBY.

function ManagerRecoveryTab({ showToast }) {
  const [nodes, setNodes]   = useState([])
  const [hosts, setHosts]   = useState([])
  const [roles, setRoles]   = useState({})
  const [loading, setLoading] = useState(true)
  const [form, setForm]     = useState(null)
  const [busy, setBusy]     = useState(false)
  const [apiMissing, setApiMissing] = useState(false)

  const inflight = useRef(false)
  const load = async () => {
    if (inflight.current) return          // never stack polls behind a slow API
    inflight.current = true
    try {
      const [n, h, m] = await Promise.all([
        axios.get('/api/rkcdp/nodes'), axios.get('/api/hosts'),
        axios.get('/api/manager_status').catch(() => ({ data: null })),
      ])
      const list = n.data && Array.isArray(n.data.nodes) ? n.data.nodes : (Array.isArray(n.data) ? n.data : null)
      setApiMissing(list === null)
      setNodes(list || [])
      setHosts(Array.isArray(h.data) ? h.data.filter(x => !x.hv_type || /prox|pve/i.test(x.hv_type)) : [])
      const r = {}
      const ms = m.data
      if (ms && Array.isArray(ms.nodes)) ms.nodes.forEach(x => { if (x.hostname) r[x.hostname] = (x.role || x.state || '').toLowerCase() })
      setRoles(r)
    } catch (e) {
      showToast?.(`Could not load recovery state: ${e.message}`, 'error')
    } finally {
      inflight.current = false
      setLoading(false)
    }
  }
  useEffect(() => {
    load()
    const t = setInterval(load, 5000)
    return () => clearInterval(t)
  }, [])

  const gb = (b) => b == null ? '—' : `${(b / 1073741824).toFixed(1)} GB`
  const gbInt = (b) => b == null ? '—' : `${Math.round(b / 1073741824)} GB`
  const ago = (t) => {
    if (!t) return '—'
    const s = Math.max(0, Math.round(Date.now() / 1000 - t))
    if (s < 60) return `${s} s ago`
    if (s < 3600) return `${Math.round(s / 60)} min ago`
    return `${new Date(t * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`
  }

  const statusOf = (n) => {
    switch (n.state) {
      case 'cdp':         return { text: 'Protected',      color: 'var(--green)' }
      case 'syncing':     return { text: 'First sync',     color: 'var(--blue)' }
      case 'seeding':     return { text: 'Seeding',        color: 'var(--blue)' }
      case 'waiting':     return { text: 'Not seeded',     color: 'var(--yellow, #eab308)' }
      case 'bitmap':      return { text: 'Catching up',    color: 'var(--yellow, #eab308)' }
      case 'paused':      return { text: 'Rebuilding',     color: 'var(--blue)' }
      case 'stale':       return { text: 'Not responding', color: 'var(--red)' }
      default:            return { text: 'Not protected',  color: 'var(--text3)' }
    }
  }

  const openRebuild = (n) => setForm({
    node: n.node, host_id: hosts[0]?.host_id ?? '', vmid: '', storage: 'local-lvm',
    bridge: 'vmbr0', force: n.state !== 'stale' && n.state !== 'unprotected',
    source: 'replica', seed_present: !!n.seed_present,
  })

  const submit = async () => {
    if (!form.host_id) { showToast?.('Pick a host', 'error'); return }
    const host = hosts.find(h => String(h.host_id) === String(form.host_id))
    if (!confirm(`Rebuild ${form.node} on ${host?.hostname || form.host_id} from its replica?\n\nIt will boot as STANDBY. Make sure the old VM is stopped or removed first (same MAC and IP).`)) return
    setBusy(true)
    try {
      await axios.post('/api/rkcdp/rebuild', {
        node: form.node, host_id: Number(form.host_id),
        vmid: form.vmid ? Number(form.vmid) : undefined,
        storage: form.storage || undefined, bridge: form.bridge || undefined,
        force: !!form.force, source: form.source,
      })
      showToast?.(`Rebuild of ${form.node} started`)
      setForm(null)
      load()
    } catch (e) {
      showToast?.(`Rebuild failed to start: ${e.response?.data?.detail || e.message}`, 'error')
    } finally {
      setBusy(false)
    }
  }

  const row = { display: 'grid', gridTemplateColumns: 'minmax(0,1.1fr) minmax(0,1.5fr) 110px auto', gap: 16, alignItems: 'center', padding: '14px 0', borderTop: '1px solid var(--border)' }

  return (
    <Section title="Manager Recovery">
      {apiMissing && <div style={{ fontSize: 12, color: 'var(--red)', marginBottom: 8 }}>
        This manager's API does not serve /api/rkcdp — the api_rkcdp module is not loaded.
      </div>}
      {loading ? <div style={{ fontSize: 12, color: 'var(--text3)' }}>Loading…</div> :
       nodes.length === 0 ? <div style={{ fontSize: 12, color: 'var(--text3)' }}>No protected managers found.</div> :
       nodes.map(n => {
        const st = statusOf(n)
        const dead = n.state === 'stale'
        const bc = n.base_copy
        const pct = bc ? Math.round(100 * bc.done / Math.max(1, bc.total)) : 0
        return (
          <Fragment key={n.node}>
            <div style={row}>
              <div>
                <div style={{ fontSize: 15, fontWeight: 600 }}>{n.node} <span style={{ fontSize: 12, color: 'var(--text3)', fontWeight: 400 }}>{roles[n.node] || ''}</span></div>
                <div style={{ fontSize: 13, color: st.color, marginTop: 2 }}>{st.text}</div>
              </div>
              <div style={{ fontSize: 13, color: 'var(--text2)' }}>
                {n.state === 'seeding' && n.seed ? (
                  <div>
                    <div>{(n.seed.phase === 'copy' || n.seed.phase === 'seed') && n.seed.percent != null ? `copying disk ${n.seed.percent}%` : n.seed.phase === 'drain' ? 'draining changes since boot' : n.seed.msg || n.seed.phase}</div>
                    {n.seed.percent != null && <div style={{ height: 4, background: 'var(--bg3)', borderRadius: 2, marginTop: 6, maxWidth: 240 }}>
                      <div style={{ height: 4, width: `${n.seed.percent}%`, background: 'var(--blue)', borderRadius: 2 }} />
                    </div>}
                  </div>
                ) : n.state === 'waiting' ? (
                  <div>Waiting for setup to seed the replica</div>
                ) : n.state === 'syncing' && bc ? (
                  <div>
                    <div>{pct}%{bc.eta_sec != null ? ` · about ${Math.max(1, Math.ceil(bc.eta_sec / 60))} min left` : ''}</div>
                    <div style={{ height: 4, background: 'var(--bg3)', borderRadius: 2, marginTop: 6, maxWidth: 240 }}>
                      <div style={{ height: 4, width: `${pct}%`, background: 'var(--blue)', borderRadius: 2 }} />
                    </div>
                  </div>
                ) : n.rebuilding && n.rebuild ? (
                  <div><RebuildProgress p={n.rebuild} /></div>
                ) : dead ? (
                  <div>Replica as of {ago(n.applied_time)}</div>
                ) : n.state === 'unprotected' ? (
                  <div>No replica yet</div>
                ) : (
                  <div>Replica up to date · {ago(n.applied_time)}</div>
                )}
              </div>
              <div style={{ fontSize: 13 }}>
                <span style={{ fontWeight: 600 }}>{gb(n.replica_used_bytes)}</span>
                <div style={{ fontSize: 12, color: 'var(--text3)' }}>{gbInt(n.replica_bytes)} disk</div>
              </div>
              <div style={{ textAlign: 'right' }}>
                {n.rebuilding
                  ? <span style={{ fontSize: 12, color: 'var(--blue)' }}>rebuilding…</span>
                  : <button style={btnStyle(dead ? 'red' : undefined)}
                            disabled={n.state === 'unprotected' || n.state === 'syncing' || n.state === 'seeding' || n.state === 'waiting'}
                            onClick={() => openRebuild(n)}>Rebuild</button>}
              </div>
            </div>
            {n.rebuild && !n.rebuilding && (n.rebuild.state === 'failed' || (n.rebuild.finished && Date.now()/1000 - n.rebuild.finished < 600)) && (
              <div style={{ padding: '8px 0 12px' }}><RebuildProgress p={n.rebuild} /></div>
            )}
            {form && form.node === n.node && (
              <div style={{ padding: '8px 0 14px', borderTop: '1px solid var(--border)' }}>
                <div style={{ display: 'grid', gridTemplateColumns: '1.6fr 2fr 1fr 1fr 1fr', gap: 10 }}>
                  <Field label="Rebuild from">
                    <Sel value={form.source} onChange={v => setForm(f => ({ ...f, source: v }))}
                         options={[{ value: 'replica', label: 'Latest replica' },
                                   ...(form.seed_present ? [{ value: 'seed', label: 'Clean seed (post-setup)' }] : [])]} />
                  </Field>
                  <Field label="Proxmox host">
                    <Sel value={form.host_id} onChange={v => setForm(f => ({ ...f, host_id: v }))}
                         options={hosts.map(h => ({ value: h.host_id, label: `${h.hostname} (${h.ip})` }))} />
                  </Field>
                  <Field label="VMID" hint="blank = next free 9100+">
                    <Inp value={form.vmid} onChange={v => setForm(f => ({ ...f, vmid: v }))} placeholder="auto" />
                  </Field>
                  <Field label="Storage"><Inp value={form.storage} onChange={v => setForm(f => ({ ...f, storage: v }))} /></Field>
                  <Field label="Bridge"><Inp value={form.bridge} onChange={v => setForm(f => ({ ...f, bridge: v }))} /></Field>
                </div>
                {form.source === 'seed' && <div style={{ fontSize: 11, color: 'var(--text2)', marginBottom: 8 }}>
                  Clean post-setup disk. Everything changed since setup comes back from the active manager (DB via heal-standby).
                </div>}
                {form.force && <div style={{ fontSize: 11, color: 'var(--yellow, #eab308)', marginBottom: 8 }}>
                  This node still reports alive. Rebuilding creates a second VM with the same MAC/IP — stop the old one first.
                </div>}
                <div style={{ display: 'flex', gap: 8 }}>
                  <button style={btnStyle('red')} disabled={busy} onClick={submit}>{busy ? 'Starting…' : 'Rebuild as STANDBY'}</button>
                  <button style={btnStyle()} onClick={() => setForm(null)}>Cancel</button>
                </div>
              </div>
            )}
          </Fragment>
        )
      })}
    </Section>
  )
}

function RebuildProgress({ p }) {
  const names = ['check', 'quiesce', 'copy', 'mark standby', 'create VM', 'boot']
  return (
    <div>
      <div style={{ display: 'flex', gap: 6, marginBottom: 6, flexWrap: 'wrap' }}>
        {names.map((nm, i) => {
          const n = i + 1
          const done = p.step > n || p.state === 'done'
          const cur = p.step === n && p.state === 'running'
          const bad = p.step === n && p.state === 'failed'
          return <span key={nm} style={{
            fontSize: 10, padding: '2px 8px', borderRadius: 10,
            background: bad ? 'rgba(239,68,68,0.15)' : done ? 'rgba(34,197,94,0.15)' : cur ? 'rgba(59,130,246,0.15)' : 'var(--bg3)',
            color: bad ? 'var(--red)' : done ? 'var(--green)' : cur ? 'var(--blue)' : 'var(--text3)',
          }}>{n}. {nm}</span>
        })}
      </div>
      <div style={{ fontSize: 12, color: p.state === 'failed' ? 'var(--red)' : p.state === 'done' ? 'var(--green)' : 'var(--text)' }}>
        {p.state === 'failed' ? `Failed: ${p.error}` : p.msg}
      </div>
    </div>
  )
}
